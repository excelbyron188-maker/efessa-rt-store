# Copy this file to .env for local development and fill in your own values.
DATABASE_URL=PASTE_YOUR_FULL_POSTGRESQL_CONNECTION_STRING_HERE
DATABASE_SSL=true
# For Neon, copy the full connection string from the Neon dashboard. Do not leave HOST or placeholder text in DATABASE_URL.
PORT=3000
NODE_ENV=development

# Use a long, random password for the private store administrator.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters


# Public URL of the deployed website, with no trailing slash.
PUBLIC_BASE_URL=http://localhost:3000
# State where the store is based; delivery settings can also be edited in the admin dashboard.
STORE_STATE=
